# =====================================================================
# CYM Pharma — .htaccess pour le front React (dossier htdocs/ ou www/)
# Hébergement mutualisé : o2switch (production) / InfinityFree (test)
# =====================================================================

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
ServerSignature Off
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers et dossiers existants passent directement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste → index.html (React Router SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression Gzip ────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── Cache des assets ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Assets avec hash dans le nom → 1 an
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  # index.html → jamais mis en cache (SPA entry point)
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ── Headers de sécurité ─────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Désactiver le cache pour index.html
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Bloquer l'accès aux fichiers sensibles ──────────────────────────
<FilesMatch "(\.env|\.git|package\.json|package-lock\.json|bun\.lock|tsconfig\.json|vite\.config\.ts)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
